# App Environment (dev, test, prod)
APP_ENV=dev

# LLM Configuration
# Primary: Google AI Studio (Gemini 3.8 Flash)
LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=your_google_api_key_here

# Fallback: Groq (OpenAI GPT-OSS 120B)
# FALLBACK_LLM_PROVIDER=groq
# FALLBACK_LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=your_groq_api_key_here

# LLM Generation Parameters
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT_SECONDS=30.0
# LLM_MAX_TOKENS=1024
# LLM_ENABLED=true

# Database Configuration (for Phase 6+)
# Direct connection (preferred for simple SQLAlchemy persistence and schema management):
# DATABASE_URL=postgresql://user:password@ep-sample-project.c-2.aws.neon.tech/neondb?sslmode=require
# RAG Configuration (Phase 7+)
# CHROMA_PERSIST_DIR=data/chroma_db
# CHROMA_COLLECTION_NAME=security_knowledge_base
# RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# RAG_TOP_K=3
# RAG_ENABLED=true
