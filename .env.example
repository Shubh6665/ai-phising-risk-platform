# App Environment (dev, test, prod)
APP_ENV=dev

# LLM Configuration
# Primary: Google AI Studio (Gemini)
LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=your_google_api_key_here

# Fallback: Groq (Llama 3.3 70B)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# Database Configuration (for Phase 6+)
# Direct connection (preferred for simple SQLAlchemy persistence and schema management):
# DATABASE_URL=postgresql://user:password@ep-sample-project.c-2.aws.neon.tech/neondb?sslmode=require
# RAG Configuration (Phase 7+)
# CHROMA_PERSIST_DIR=data/chroma_db
# CHROMA_COLLECTION_NAME=security_knowledge_base
# RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
